#!@bash@
set -euo pipefail

umask 077

readonly REAL_CLIPHIST="@cliphist@"
readonly MOUNTPOINT="@mountpoint@"
readonly SYSTEMCTL="@systemctl@"
readonly INSTALL="@install@"
readonly CHMOD="@chmod@"
readonly RM="@rm@"

fail() {
  printf 'cliphist-secure: %s\n' "$*" >&2
  exit 1
}

usage() {
  printf '%s\n' \
    'Usage:' \
    '  cliphist store|list|decode|delete|delete-query|wipe [arguments...]' \
    '  cliphist capture pause|resume|status' \
    '  cliphist version' >&2
  exit 2
}

[[ -n "${HOME:-}" ]] || fail 'HOME is not set'
[[ -n "${XDG_RUNTIME_DIR:-}" ]] || fail 'XDG_RUNTIME_DIR is not set'
[[ -d "$XDG_RUNTIME_DIR" ]] || fail "runtime directory does not exist: $XDG_RUNTIME_DIR"

readonly RUNTIME_ROOT="$XDG_RUNTIME_DIR/cliphist-vault"
readonly PLAIN_DIR="$RUNTIME_ROOT/plain"
readonly DB_PATH="$PLAIN_DIR/db"
readonly CONTROL_DIR="$RUNTIME_ROOT/control"
readonly PAUSED_FILE="$CONTROL_DIR/capture-paused"

is_mounted() {
  "$MOUNTPOINT" --quiet -- "$PLAIN_DIR"
}

ensure_mounted() {
  if ! is_mounted; then
    "$SYSTEMCTL" --user start cliphist-vault.service >/dev/null
  fi

  is_mounted || fail 'encrypted clipboard vault is not mounted'
}

ensure_control_dir() {
  "$INSTALL" -d -m 0700 -- "$CONTROL_DIR"
}

capture_command() {
  [[ $# -eq 1 ]] || usage

  case "$1" in
    pause)
      ensure_mounted
      ensure_control_dir
      : >"$PAUSED_FILE"
      "$CHMOD" 0600 -- "$PAUSED_FILE"
      ;;
    resume)
      "$RM" -f -- "$PAUSED_FILE"
      ;;
    status)
      if [[ -e "$PAUSED_FILE" ]]; then
        printf 'paused\n'
      else
        printf 'active\n'
      fi
      ;;
    *)
      usage
      ;;
  esac
}

[[ $# -gt 0 ]] || usage

command_name="$1"
shift

case "$command_name" in
  capture)
    capture_command "$@"
    exit 0
    ;;
  version)
    [[ $# -eq 0 ]] || usage
    exec "$REAL_CLIPHIST" -config-path /dev/null version
    ;;
  store)
    # Reject password-manager data before opening the vault or reading stdin.
    if [[ "${CLIPBOARD_STATE:-}" == 'sensitive' ]]; then
      exit 0
    fi

    if [[ -e "$PAUSED_FILE" ]]; then
      exit 0
    fi
    ;;
  list | decode | delete | delete-query | wipe)
    ;;
  *)
    usage
    ;;
esac

for argument in "$@"; do
  case "$argument" in
    -db-path | -db-path=* | --db-path | --db-path=*)
      fail 'overriding the encrypted database path is not allowed'
      ;;
  esac
done

ensure_mounted

# cliphist applies environment and config-file values after CLI flags. Remove
# every supported override and use an empty config so storage cannot escape
# the encrypted mount or silently expand retention.
unset \
  CLIPHIST_CONFIG_PATH \
  CLIPHIST_DB_PATH \
  CLIPHIST_MAX_DEDUPE_SEARCH \
  CLIPHIST_MAX_ITEMS \
  CLIPHIST_MIN_STORE_LENGTH \
  CLIPHIST_PREVIEW_WIDTH

exec "$REAL_CLIPHIST" \
  -config-path /dev/null \
  -db-path "$DB_PATH" \
  -max-items 200 \
  "$command_name" "$@"
