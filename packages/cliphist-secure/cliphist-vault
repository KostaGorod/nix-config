#!@bash@
set -euo pipefail

umask 077

readonly SECRET_TOOL="@secret_tool@"
readonly OPENSSL="@openssl@"
readonly GOCRYPTFS="@gocryptfs@"
readonly MOUNTPOINT="@mountpoint@"
readonly FUSERMOUNT="@fusermount@"
readonly INSTALL="@install@"
readonly CHMOD="@chmod@"
readonly STAT="@stat@"
readonly FIND="@find@"
readonly GREP="@grep@"
readonly RM="@rm@"
readonly RMDIR="@rmdir@"
readonly SLEEP="@sleep@"

fail() {
  printf 'cliphist-vault: %s\n' "$*" >&2
  exit 1
}

[[ -n "${HOME:-}" ]] || fail 'HOME is not set'
[[ -n "${XDG_RUNTIME_DIR:-}" ]] || fail 'XDG_RUNTIME_DIR is not set'
[[ -d "$XDG_RUNTIME_DIR" ]] || fail "runtime directory does not exist: $XDG_RUNTIME_DIR"

readonly STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
readonly STATE_ROOT="$STATE_HOME/cliphist-vault"
readonly CIPHER_DIR="$STATE_ROOT/cipher"
readonly MIGRATION_MARKER="$STATE_ROOT/.legacy-purged-v1"
readonly RUNTIME_ROOT="$XDG_RUNTIME_DIR/cliphist-vault"
readonly PLAIN_DIR="$RUNTIME_ROOT/plain"
readonly KEY_APPLICATION='cliphist'
readonly KEY_PURPOSE='history-master-key'

secure_directory() {
  local path="$1"

  [[ ! -L "$path" ]] || fail "refusing symlinked directory: $path"
  "$INSTALL" -d -m 0700 -- "$path"

  [[ "$($STAT -c '%u' -- "$path")" == "$UID" ]] || fail "directory is not owned by uid $UID: $path"
  [[ "$($STAT -c '%a' -- "$path")" == '700' ]] || fail "directory permissions are not 0700: $path"
}

prepare_directories() {
  secure_directory "$STATE_ROOT"
  secure_directory "$CIPHER_DIR"
  secure_directory "$RUNTIME_ROOT"
  secure_directory "$PLAIN_DIR"
}

lookup_master_key() {
  "$SECRET_TOOL" lookup application "$KEY_APPLICATION" purpose "$KEY_PURPOSE" 2>/dev/null || true
}

store_master_key() {
  local master_key="$1"

  printf '%s\n' "$master_key" | "$SECRET_TOOL" store \
    --label='Encrypted clipboard history master key' \
    application "$KEY_APPLICATION" \
    purpose "$KEY_PURPOSE" >/dev/null
}

get_or_create_master_key() {
  local master_key

  master_key="$(lookup_master_key)"
  if [[ -z "$master_key" ]]; then
    if [[ -e "$CIPHER_DIR/gocryptfs.conf" ]]; then
      fail 'the vault exists but its GNOME Keyring master key is unavailable'
    fi

    master_key="$($OPENSSL rand -hex 32)"
    [[ "$master_key" =~ ^[0-9a-fA-F]{64}$ ]] || fail 'failed to generate a 256-bit master key'
    store_master_key "$master_key"

    [[ "$(lookup_master_key)" == "$master_key" ]] || fail 'GNOME Keyring did not return the stored master key'
  fi

  [[ "$master_key" =~ ^[0-9a-fA-F]{64}$ ]] || fail 'GNOME Keyring returned an invalid master key'
  printf '%s\n' "$master_key"
}

initialize_cipher_directory() {
  local master_key="$1"

  if [[ -e "$CIPHER_DIR/gocryptfs.conf" ]]; then
    return
  fi

  if "$FIND" "$CIPHER_DIR" -mindepth 1 -print -quit | "$GREP" --quiet .; then
    fail 'encrypted backing directory is non-empty but has no gocryptfs configuration'
  fi

  # gocryptfs initialization reads a configuration password twice, then the
  # explicit master key. Use the keyring value for all three prompts; mounts
  # bypass the config password and read the master key directly from stdin.
  printf '%s\n%s\n%s\n' "$master_key" "$master_key" "$master_key" | \
    "$GOCRYPTFS" \
      -quiet \
      -init \
      -masterkey=stdin \
      -- "$CIPHER_DIR"
}

purge_legacy_history_once() {
  if [[ -e "$MIGRATION_MARKER" ]]; then
    return
  fi

  "$RM" -f -- \
    "$HOME/.cache/cliphist/db" \
    "$HOME/.cache/cliphist/db.tmp"
  "$RMDIR" --ignore-fail-on-non-empty -- "$HOME/.cache/cliphist" 2>/dev/null || true

  : >"$MIGRATION_MARKER"
  "$CHMOD" 0600 -- "$MIGRATION_MARKER"
}

initialize_vault() {
  local master_key

  prepare_directories
  master_key="$(get_or_create_master_key)"
  initialize_cipher_directory "$master_key"
  purge_legacy_history_once
  printf '%s\n' "$master_key"
}

mount_vault() {
  local master_key

  "$MOUNTPOINT" --quiet -- "$PLAIN_DIR" && fail 'clipboard vault is already mounted'
  master_key="$(initialize_vault)"

  # Process substitution is a pipe on Linux, keeping the key out of temporary
  # files while allowing the shell to erase its copy before exec.
  exec 3< <(printf '%s\n' "$master_key")
  unset master_key

  exec "$GOCRYPTFS" \
    -fg \
    -quiet \
    -nodev \
    -noexec \
    -nosuid \
    -masterkey=stdin \
    -- "$CIPHER_DIR" "$PLAIN_DIR" <&3
}

wait_for_mount() {
  local attempt

  for ((attempt = 0; attempt < 100; attempt++)); do
    if "$MOUNTPOINT" --quiet -- "$PLAIN_DIR"; then
      exit 0
    fi
    "$SLEEP" 0.1
  done

  fail 'timed out waiting for the encrypted clipboard mount'
}

unmount_vault() {
  if "$MOUNTPOINT" --quiet -- "$PLAIN_DIR"; then
    "$FUSERMOUNT" -u "$PLAIN_DIR"
  fi
}

status_vault() {
  if "$MOUNTPOINT" --quiet -- "$PLAIN_DIR"; then
    printf 'mounted\n'
  else
    printf 'unmounted\n'
    exit 1
  fi
}

[[ $# -eq 1 ]] || fail 'expected one command: init, mount, wait, unmount, or status'

case "$1" in
  init)
    initialize_vault >/dev/null
    ;;
  mount)
    mount_vault
    ;;
  wait)
    wait_for_mount
    ;;
  unmount)
    unmount_vault
    ;;
  status)
    status_vault
    ;;
  *)
    fail "unknown command: $1"
    ;;
esac
